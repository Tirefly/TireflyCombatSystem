# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
nul

# Script/：UnrealSharp 生成物一律不入库——glue 工程、用户工程、加载顺序清单、构建产物。
# TCS 是纯 C++ 插件，本仓不含任何 C# 脚本；手写 C# 只有 Source/*/*.Build.cs（在 Source/ 下，
# 不受本段影响），宿主 C# 脚本住在 LAC 仓的 Script/LegendAutoChessCS/。
# （Script/ 下的 .sln 由上面的 `*.sln` 覆盖。）本段必须是忽略而非 `!` 放行：
# 2026-05-21 曾被反转为 `!`，导致两个 glue 工程被提交进库，2026-08-23 删 UnrealSharp 时漏改回。
Script/*.Glue/
Script/*.RuntimeGlue/
Script/**/*.csproj
Script/**/bin/
Script/**/obj/
Script/**/Properties/launchSettings.json

# Git worktrees created inside the TCS submodule
.worktrees/
